# Copy to .env and fill in. Only OPENAI_API_KEY has no usable default.
#   cp .env.example .env

# --- Upstream OpenAI credentials, used by the middleware only ---------------
# The real key goes in .env, which is gitignored — never in this file, which is
# tracked. This template must only ever hold a placeholder.
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Middleware behaviour ---------------------------------------------------
# Models advertised to Open WebUI on GET /v1/models, comma separated.
EXPOSED_MODELS=gpt-4o-mini
LOG_LEVEL=INFO

# Timeouts are per-operation, not an overall deadline: CONNECT fails fast on a dead
# upstream, READ bounds the gap between streamed chunks. There is no total budget, so
# a stream that keeps producing tokens is never cut short.
CONNECT_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=90

# --- Local stack (docker compose) -------------------------------------------
# Everything below has a working default; override only if a port clashes.

# The credential Open WebUI presents to the middleware. Any non-empty value works:
# the middleware ignores it and authenticates upstream with OPENAI_API_KEY above.
MIDDLEWARE_API_KEY=local-dev-placeholder

# Signs Open WebUI session tokens. Change it for anything longer-lived than a demo.
WEBUI_SECRET_KEY=local-dev-secret-change-me

POSTGRES_USER=openwebui
POSTGRES_PASSWORD=openwebui
POSTGRES_DB=openwebui

# Host ports. Postgres is deliberately not published.
OPEN_WEBUI_PORT=3000
MIDDLEWARE_PORT=8000
